            <column caption='Clean Volume' datatype='real' name='[Calculation_437130638878363657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF RIGHT([Vol.],1) = &quot;K&quot; THEN&#13;&#10;FLOAT(LEFT([Vol.],LEN([Vol.])-1)) * 1000&#13;&#10;&#13;&#10;ELSEIF RIGHT([Vol.],1) = &quot;M&quot; THEN&#13;&#10;FLOAT(LEFT([Vol.],LEN([Vol.])-1)) * 1000000&#13;&#10;&#13;&#10;ELSE&#13;&#10;FLOAT([Vol.])&#13;&#10;END' />
            </column>
            <column caption='Avg Daily Volume' datatype='real' name='[Calculation_986851268708016128]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_437130638878363657]) / 1000000' />
