      <aliases enabled='yes' />
      <column caption='Diffrence  between Open and Close' datatype='real' name='[Calculation_1057501553155682307]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Close])-SUM([Open])' />
      </column>
      <column caption='Difference between High and Low' datatype='real' name='[Calculation_1057501553155866628]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([High])-SUM([Low])' />
      </column>
      <column caption='pos' datatype='real' name='[Calculation_401664791942529029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Close] &gt; [Open] THEN 1 ELSE 0 END) / COUNT([Date])' />
      </column>
      <column caption='neg' datatype='real' name='[Calculation_401664791942643718]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Close] &lt; [Open] THEN 1 ELSE 0 END) / COUNT([Date])' />
      </column>
      <column caption='Total volume' datatype='real' name='[Calculation_401664791943102471]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_437130638878363657])/1000' />
      </column>
      <column caption='Company' datatype='string' name='[Calculation_437130638861230080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Table Name], &quot;META HISTORICAL DATA.csv&quot;) THEN &quot;Meta&quot;&#13;&#10;ELSEIF CONTAINS([Table Name], &quot;SNAP Historical Data.csv&quot;) THEN &quot;Snap&quot;&#13;&#10;ELSEIF CONTAINS([Table Name], &quot;PINS Historical Data.csv&quot;) THEN &quot;Pinterest&quot;&#13;&#10;ELSE &quot;Spotify&quot;&#13;&#10;END' />
      </column>
      <column caption='Dashboard Title' datatype='string' name='[Calculation_437130638867472385]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([Calculation_437130638861230080]) = 1 THEN&#13;&#10;ATTR([Calculation_437130638861230080])+ &quot; Stock Analysis&quot;&#13;&#10;ELSE&#13;&#10;&quot;Social Media Stock Analysis&quot;&#13;&#10;END' />
      </column>
      <column caption='Comparative growth' datatype='real' name='[Calculation_437130638872313860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Close])&#13;&#10;/&#13;&#10;WINDOW_MIN(SUM([Close]))&#13;&#10;* 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Clean Volume' datatype='real' name='[Calculation_437130638878363657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF RIGHT([Vol.],1) = &quot;K&quot; THEN&#13;&#10;FLOAT(LEFT([Vol.],LEN([Vol.])-1)) * 1000&#13;&#10;&#13;&#10;ELSEIF RIGHT([Vol.],1) = &quot;M&quot; THEN&#13;&#10;FLOAT(LEFT([Vol.],LEN([Vol.])-1)) * 1000000&#13;&#10;&#13;&#10;ELSE&#13;&#10;FLOAT([Vol.])&#13;&#10;END' />
      </column>
      <column caption='Volume(M)' datatype='real' name='[Calculation_437130638880751626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_437130638878363657]) / 1000000' />
      </column>
      <column caption='Daily Return' datatype='real' name='[Calculation_437130638888140818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(AVG([Close]) - LOOKUP(AVG([Close]),-1)) / ABS(LOOKUP(AVG([Close]),-1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg Daily Return' datatype='real' name='[Calculation_437130638928801819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([Close]) / LOOKUP(AVG([Close]), -1) - 1, FIRST(), LAST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Risk (Std Dev)' datatype='real' name='[Calculation_437130638928900124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_STDEV(AVG([Close]) / LOOKUP(AVG([Close]), -1) - 1, FIRST(), LAST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Volatility' datatype='real' name='[Calculation_437130638937219107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='STDEV([Close])' />
      </column>
      <column caption='Avg Daily Return %' datatype='real' name='[Calculation_437130638945005609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(([Close] - [Open]) / [Open] * 100)' />
      </column>
      <column caption='Avg Daily Volume' datatype='real' name='[Calculation_986851268708016128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_437130638878363657]) / 1000000' />
      </column>
